# Server
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas

# Redis
REDIS_URL=redis://localhost:6379

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass

# Invoice storage
INVOICE_DIR=./invoices
BASE_URL=http://localhost:3000
MAIL_FROM=billing@saas.local
# Leave SMTP_* empty to auto-use an Ethereal test inbox (preview URL is printed in the logs)

# Stripe plan Price IDs (create 3 recurring monthly prices in the Stripe test dashboard)
PRICE_100=
PRICE_500=
PRICE_1000=
